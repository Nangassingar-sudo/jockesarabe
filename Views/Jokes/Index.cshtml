@model IEnumerable<JokesWebApp.Models.Joke>

@{
    ViewData["Title"] = "Jokes";
}

<div class="container mt-4">
    <h1 class="mb-4">Jokes</h1>

    <!-- Search bar and Create New button -->
    <div class="row mb-4">
        <div class="col-md-8">
            <form method="get" class="d-flex">
                <input type="text" name="searchTerm" class="form-control me-2" placeholder="Search jokes..." value="@ViewBag.SearchTerm" />
                <button type="submit" class="btn btn-outline-primary">Search</button>
            </form>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">Create New</a>
        </div>
    </div>

    <!-- Jokes table -->
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>JokeQuestion</th>
                <th>JokeAnswer</th>
                <th>Likes</th>
                <th>Comments</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                var isOwner = item.UserId == currentUserId;
                
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.JokeQuestion!.Text)</td>
                    <td>@Html.DisplayFor(modelItem => item.JokeAnswer!.Text)</td>
                    <td>
                        <span class="badge bg-success">@item.LikesCount</span>
                        <form method="post" asp-action="Like" asp-route-id="@item.Id" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-success ms-2">
                                👍
                            </button>
                        </form>
                    </td>
                    <td>
                        <span class="badge bg-info">@item.Comments.Count</span>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info ms-2">
                            💬
                        </a>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        
                        @if (isOwner)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No jokes found. <a asp-action="Create" class="alert-link">Create the first one!</a>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .btn-sm {
        margin-right: 5px;
        margin-top: 2px;
    }
</style>

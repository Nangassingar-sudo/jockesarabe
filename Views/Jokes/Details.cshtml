@model JokesWebApp.Models.Joke

@{
    ViewData["Title"] = "Joke Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>@ViewData["Title"]</h1>

            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Question</h5>
                </div>
                <div class="card-body">
                    <p class="h6">@Model.JokeQuestion?.Text</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Answer</h5>
                </div>
                <div class="card-body">
                    <p class="h6">@Model.JokeAnswer?.Text</p>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Likes</h5>
                            <p class="display-4 text-success">@Model.LikesCount</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Author</h5>
                            <p class="lead">@Model.User?.UserName</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Comments Section -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">💬 Comments (@Model.Comments.Count)</h5>
                </div>
                <div class="card-body">
                    @if (Model.Comments.Any())
                    {
                        foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
                        {
                            <div class="border-bottom pb-2 mb-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <strong>@comment.User?.UserName</strong>
                                        <small class="text-muted ms-2">@comment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                        <p class="mt-2 mb-0">@comment.Text</p>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No comments yet. Be the first to comment!</p>
                    }

                    <!-- Add Comment Form -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <form method="post" asp-action="AddComment" class="mt-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="jokeId" value="@Model.Id" />
                            <div class="input-group">
                                <input type="text" name="commentText" class="form-control" placeholder="Add a comment..." maxlength="500" required />
                                <button type="submit" class="btn btn-primary">Post</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info mt-3">
                            <a asp-area="Identity" asp-page="/Account/Login">Log in</a> to add comments.
                        </div>
                    }
                </div>
            </div>

            <div class="mb-4">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                
                @{
                    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    var isOwner = Model.UserId == currentUserId;
                }
                
                @if (isOwner)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                }
            </div>
        </div>
    </div>
</div>

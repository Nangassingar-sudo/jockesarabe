@model JokesWebApp.Models.Joke

@{
    ViewData["Title"] = "Delete Joke";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>@ViewData["Title"]</h1>

            <div class="alert alert-danger" role="alert">
                ⚠️ Are you sure you want to delete this joke? This action cannot be undone.
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label"><strong>Question:</strong></label>
                        <p class="form-control-plaintext">@Model.JokeQuestion?.Text</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Answer:</strong></label>
                        <p class="form-control-plaintext">@Model.JokeAnswer?.Text</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Likes:</strong></label>
                        <p class="form-control-plaintext">@Model.LikesCount</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Author:</strong></label>
                        <p class="form-control-plaintext">@Model.User?.UserName</p>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>

@model JokesWebApp.Models.Joke

@{
    ViewData["Title"] = "Edit Joke";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>@ViewData["Title"]</h1>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)

                <div class="mb-3">
                    <label asp-for="JokeQuestionId" class="form-label">Question</label>
                    <select asp-for="JokeQuestionId" class="form-select" asp-items="ViewBag.JokeQuestionId">
                        <option value="">-- Select Question --</option>
                    </select>
                    <span asp-validation-for="JokeQuestionId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="JokeAnswerId" class="form-label">Answer</label>
                    <select asp-for="JokeAnswerId" class="form-select" asp-items="ViewBag.JokeAnswerId">
                        <option value="">-- Select Answer --</option>
                    </select>
                    <span asp-validation-for="JokeAnswerId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
